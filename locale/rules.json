{
  "scan_directories": [
    "src/BizHawk.Client.EmuHawk",
    "src/BizHawk.Client.Common",
    "src/BizHawk.WinForms.Controls"
  ],
  "file_extensions": [
    ".cs"
  ],
  "exclude_directories": [
    "bin",
    "obj",
    ".git",
    ".vs",
    "Assets",
    "ExternalToolProjects",
    "src/BizHawk.Emulation.Cores",
    "src/BizHawk.Emulation.Disc.DiscImage"
  ],
  "match_patterns": [
    {
      "name": "Property Assignment (.Text = \"...\")",
      "regex": "(\\bText\\s*=\\s*\")([^\"]+)(\")",
      "priority": 1
    },
    {
      "name": "ToolTipText Assignment (.ToolTipText = \"...\")",
      "regex": "(\\bToolTipText\\s*=\\s*\")([^\"]+)(\")",
      "priority": 1
    },
    {
      "name": "HeaderText Assignment (.HeaderText = \"...\")",
      "regex": "(\\bHeaderText\\s*=\\s*\")([^\"]+)(\")",
      "priority": 1
    },
    {
      "name": "ToolStripMenuItem / ToolStripItem Constructors",
      "regex": "(new\\s+ToolStrip(?:MenuItem|Button|DropDownButton|Label|StatusLabel|DropDownItem)\\s*\\(\\s*\")([^\"]+)(\")",
      "priority": 2
    },
    {
      "name": "TabPage Constructor",
      "regex": "(new\\s+TabPage\\s*\\(\\s*\")([^\"]+)(\")",
      "priority": 2
    },
    {
      "name": "SetToolTip Method Call",
      "regex": "(SetToolTip\\s*\\([^,]+,\\s*\")([^\"]+)(\")",
      "priority": 2
    },
    {
      "name": "MessageBox / MsgBox / Modal Calls",
      "regex": "(MessageBox(?:Ex)?\\.Show\\s*\\(\\s*\")([^\"]+)(\")",
      "priority": 3
    },
    {
      "name": "AddOnScreenMessage (OSD HUD Messages)",
      "regex": "(AddOnScreenMessage\\s*\\(\\s*\")([^\"]+)(\")",
      "priority": 3
    },
    {
      "name": "ShowMessageIfError",
      "regex": "(ShowMessageIfError\\s*\\([^,]+,\\s*\")([^\"]+)(\")",
      "priority": 3
    },
    {
      "name": "DisplayMessageIfFailed",
      "regex": "(DisplayMessageIfFailed\\s*\\([^,]+,\\s*\")([^\"]+)(\")",
      "priority": 3
    },
    {
      "name": "ModalMessageBox / ShowMessageBox Calls",
      "regex": "((?:ModalMessageBox|ShowMessageBox|ShowMessageBox2|ShowMessageBox3|ShowWarning|ShowError|ShowInfo|AddMessage|Notify\\.Warn|Notify\\.Error|Notify\\.Info)\\s*\\(\\s*(?:owner:\\s*[^,]+,\\s*)?(?:text:\\s*)?\")([^\"]+)(\")",
      "priority": 3
    },
    {
      "name": "Named Parameters (title / message / caption)",
      "regex": "((?:title|message|caption|prefixMessage|errorText):\\s*\")([^\"]+)(\")",
      "priority": 3
    },
    {
      "name": "Component Property Attributes",
      "regex": "(\\[(?:DisplayName|Description|Category|Tool|Config)\\s*\\(\\s*\")([^\"]+)(\")",
      "priority": 4
    },
    {
      "name": "Columns / ListView / ComboBox Add Text",
      "regex": "(Columns\\.Add\\s*\\([^,]+,\\s*\")([^\"]+)(\")",
      "priority": 4
    },
    {
      "name": "UnlessUsingApiException / User Exceptions",
      "regex": "(new\\s+(?:UnlessUsingApiException|Exception|InvalidOperationException|ArgumentException)\\s*\\(\\s*\")([^\"]+)(\")",
      "priority": 4
    }
  ],
  "blacklist_exact": [
    "",
    " ",
    "-",
    "--",
    "...",
    "OK",
    "None",
    "0",
    "1",
    "N/A",
    "null",
    "true",
    "false",
    "Arial",
    "Courier New",
    "Microsoft Sans Serif",
    "Segoe UI",
    "Tahoma"
  ],
  "blacklist_regex": [
    "^[0-9\\.\\-\\+\\*/%\\$#@!~]+$",
    "^http(s)?://",
    "^\\{[0-9]+\\}$",
    "^%[a-zA-Z0-9_]+%$",
    "^[#\\$]+[0-9a-fA-F\\?XD]+$",
    "^[a-zA-Z0-9_]+\\.(dll|exe|rom|bin|nes|sfc|smc|z64|gb|gba|gen|iso|chd|cue|lua|txt|json|xml)$"
  ]
}
